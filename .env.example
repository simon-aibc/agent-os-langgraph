# .env.example
# Copy this file to .env and replace placeholders with actual keys.
# DO NOT commit .env to version control.

# LLM Provider Configuration
# Set the provider and model in the LLM roles below.

# API Keys (set only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosting Network (Console and CORS)
AGENT_OS_API_BASE=http://127.0.0.1:4680
AGENT_OS_CORS_ORIGINS=http://127.0.0.1:4100

# The runtime reads exactly these three model roles.
# API/local models use LiteLLM provider/model format.
LLM_ROUTER="ollama/qwen2.5:14b"
LLM_ARCHITECT="anthropic/claude-opus-4-8"
LLM_EXECUTOR="openai/gpt-5.5"

# --- Subscription CLI backends ---
# Require the corresponding binary on PATH and authentication before startup.
# Claude-only: set both roles to cli/claude-code.
# Codex-only: set both roles to cli/codex.
# Mixed example:
# LLM_ARCHITECT=cli/claude-code
# LLM_EXECUTOR=cli/codex

# Workspace Configuration
AGENT_OS_WORKSPACE="."
AGENT_OS_SANDBOX="/workspace"

# Durable LangGraph checkpoints (may contain sensitive workflow state)
AGENT_OS_CHECKPOINTS_DB="./checkpoints.db"

# MCP integrations
MCP_FILESYSTEM_ENABLED="false"
MCP_CODEGRAPH_ENABLED="false"
MCP_CODEGRAPH_COMMAND="codegraph"
MCP_GBRAIN_URL=""
