# .env.example
# Copy this file to .env and replace placeholders with actual keys.
# DO NOT commit .env to version control.

# Example LLM provider keys (not used in R1)
# OPENAI_API_KEY="your-openai-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# LLM Role configurations (provider/model format)
LLM_SUPERVISOR="anthropic/claude-opus-4-8"
LLM_ARCHITECT="anthropic/claude-opus-4-8"
LLM_EXECUTOR="openai/gpt-5.5"
LLM_ROUTER="ollama/qwen2.5:14b"
LLM_CHEAP="ollama/mistral-small3.2"

# Sandbox Configuration
AGENT_OS_SANDBOX="./sandbox"
